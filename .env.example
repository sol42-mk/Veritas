# Copy this file to .env.local.
#
# The current register flow uses Phantom in the browser to sign and pay for
# Solana devnet transactions. It does not need a server-side wallet private key.

# Optional: used later for the AI fallback on unverified videos.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Supabase context/flag store.
# If these are unset, Veritas uses the local .veritas-data fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional local-only performance tuning for backend watermarking.
# Leave these unset for portable CPU defaults.
#
# To try NVIDIA NVENC locally, install/use an ffmpeg build with h264_nvenc:
# VERITAS_DCT_BACKEND=cpu
# VERITAS_DCT_FALLBACK=cpu
# VERITAS_FFMPEG_PATH=/usr/bin/ffmpeg
# VERITAS_FFPROBE_PATH=/usr/bin/ffprobe
# VERITAS_VIDEO_ENCODER=nvenc
# VERITAS_NVENC_PRESET=p4
# VERITAS_NVENC_CQ=23
#
# CPU encoder tuning:
# VERITAS_X264_PRESET=ultrafast
# VERITAS_X264_CRF=23
#
# Optional VideoHash perceptual fingerprinting for new registrations.
# If unset or unavailable, Veritas falls back to the legacy SHA-256 field.
# VERITAS_VIDEOHASH_PYTHON=/home/shenol/projects/veritas/.venv-videohash/bin/python
# VERITAS_VIDEOHASH_WORKER=/home/shenol/projects/veritas/workers/videohash/veritas_videohash.py
#
# FPS tuning:
# By default, Veritas preserves source FPS up to 30 FPS.
# VERITAS_MAX_WATERMARK_FPS=30
# VERITAS_WATERMARK_FPS=24
#
# Experimental full CUDA DCT worker. Requires local Python + CuPy.
# CPU remains the default and this should usually stay unset in shared config.
# VERITAS_DCT_BACKEND=cuda
# VERITAS_DCT_FALLBACK=cpu
# VERITAS_CUDA_PYTHON=/home/shenol/projects/veritas/.venv-cuda/bin/python
# VERITAS_CUDA_DCT_WORKER=/home/shenol/projects/veritas/workers/cuda-dct/veritas_cuda_dct.py
#
# Tested local CUDA venv dependency set:
# python -m pip install numpy cupy-cuda12x nvidia-cuda-nvrtc-cu12 nvidia-cuda-runtime-cu12 nvidia-cublas-cu12
